        { "name": "gc", "type": "Number", "description": "Goles en Contra" },
        { "name": "dg", "type": "Formula", "description": "Diferencia de Gol", "formula": "=J{row}-K{row}" },
        { "name": "puntos", "type": "Formula", "description": "Puntos totales (3 por PG + 1 por PE)", "formula": "=(G{row}*3)+(H{row}*1)" }
